+    from ultralytics import YOLO  # heavy: only when DETECTOR=yolo
+
+    return YOLO(weights)
+
+
+def _detect_yolo(image: Image.Image) -> list[Box]:
+    model = _load_yolo(get_settings().DETECTOR_WEIGHTS)
+    result = model.predict(image, verbose=False)[0]
+    names = result.names
+    boxes: list[Box] = []
+    for xyxyn, conf, cls in zip(result.boxes.xyxyn.tolist(), result.boxes.conf.tolist(),
+                                result.boxes.cls.tolist()):
+        label = names[int(cls)]
+        if conf < MIN_SCORE or label in _IGNORE_LABELS:
+            continue
+        x1, y1, x2, y2 = (min(max(v, 0.0), 1.0) for v in xyxyn)
+        if x2 - x1 <= 0 or y2 - y1 <= 0:
+            continue
+        boxes.append(Box(x=x1, y=y1, w=x2 - x1, h=y2 - y1, label=label, score=float(conf)))
+    return boxes

+        {"id": "sim", "price": 12.0, "rating": 4.5, "review_count": 5, "match_label": "similar"},
+        {"id": "none", "price": 1.0, "rating": 5.0, "review_count": 999, "match_label": "none"},
+        {"id": "noprice", "price": None, "rating": 5.0, "review_count": 999, "match_label": "identical"},
+        {"id": "zero", "price": 0.0, "rating": 5.0, "review_count": 999, "match_label": "identical"},

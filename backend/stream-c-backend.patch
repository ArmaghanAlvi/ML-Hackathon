+"""images.py
+
+Owner: Stream C · Roadmap: Stage 4d (candidate image fetching), 4g (cached mode), 9b (speed)
+Purpose: decode the user's image, and download candidate images safely, in parallel, with a disk
+cache so DEMO_CACHED mode can re-score without any network.
+
+Safety rules for URLs (suggestion 7): http(s) only, no private / loopback / link-local / reserved
+addresses (checked again on every redirect), a timeout, and a byte cap. Base64 uploads are capped.
+"""
+from __future__ import annotations
+
+import base64
+import binascii
+import hashlib
+import io
+import ipaddress
+import socket
+import uuid
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+from urllib.parse import urljoin, urlparse
+
+from PIL import Image, ImageOps, UnidentifiedImageError
+
+from backend.app.config import get_settings
+
+MAX_REDIRECTS = 3
+Image.MAX_IMAGE_PIXELS = 40_000_000  # refuse decompression bombs
+_USER_AGENT = "SnapShop/0.1 (hackathon project)"
+
+
+class ImageError(ValueError):
+    """The image could not be read (bad base64, not an image, too big)."""
+
+
+class UnsafeURLError(ImageError):
+    """The URL is not allowed (scheme, private address, ...)."""
+
+
+class OfflineCacheMiss(ImageError):
+    """DEMO_CACHED is on and this image URL was never cached."""
+
+
+# ---------------------------------------------------------------------------
+# Decoding
+# ---------------------------------------------------------------------------
+def decode_base64(data: str) -> bytes:
+    """Decode a base64 image (a data: URL prefix is allowed), enforcing MAX_IMAGE_BYTES."""
+    if "," in data and data.lstrip().startswith("data:"):
+        data = data.split(",", 1)[1]
+    max_bytes = get_settings().MAX_IMAGE_BYTES
+    if len(data) > (max_bytes * 4) // 3 + 4:
+        raise ImageError(f"image is larger than {max_bytes} bytes")
+    try:
+        return base64.b64decode(data, validate=False)
+    except (binascii.Error, ValueError) as e:
+        raise ImageError("image_base64 is not valid base64") from e
+
+
+def load_image(raw: bytes) -> Image.Image:
+    """Bytes -> RGB PIL image, with phone EXIF rotation applied."""
+    try:
+        img = Image.open(io.BytesIO(raw))
+        img = ImageOps.exif_transpose(img)
+        return img.convert("RGB")
+    except (UnidentifiedImageError, OSError, Image.DecompressionBombError) as e:
+        raise ImageError("could not read the image") from e
+
+
+def to_jpeg(img: Image.Image, max_bytes: int = 450_000, max_side: int = 1024) -> bytes:
+    """Encode as JPEG under `max_bytes` (SerpApi's upload limit is 500 KB), shrinking if needed."""
+    img = img.convert("RGB")
+    if max(img.size) > max_side:
+        img = img.copy()
+        img.thumbnail((max_side, max_side))
+    for quality in (90, 80, 70, 60, 50):
+        buf = io.BytesIO()
+        img.save(buf, format="JPEG", quality=quality)
+        if buf.tell() <= max_bytes:
+            return buf.getvalue()
+    img = img.copy()
+    img.thumbnail((max_side // 2, max_side // 2))
+    buf = io.BytesIO()
+    img.save(buf, format="JPEG", quality=60)
+    return buf.getvalue()
+
+
+# ---------------------------------------------------------------------------
+# URL safety
+# ---------------------------------------------------------------------------
+def _is_public_ip(ip: str) -> bool:
+    addr = ipaddress.ip_address(ip)
+    return not (
+        addr.is_private or addr.is_loopback or addr.is_link_local or addr.is_reserved
+        or addr.is_multicast or addr.is_unspecified
+    )
+
+
+def check_url(url: str) -> None:
+    """Raise UnsafeURLError unless `url` is http(s) and every address it resolves to is public."""
+    parsed = urlparse(url)
+    if parsed.scheme not in ("http", "https"):
+        raise UnsafeURLError("only http(s) image URLs are allowed")
+    host = parsed.hostname
+    if not host:
+        raise UnsafeURLError("image URL has no host")
+    try:
+        infos = socket.getaddrinfo(host, parsed.port or (443 if parsed.scheme == "https" else 80))
+    except socket.gaierror as e:
+        raise UnsafeURLError(f"cannot resolve host {host}") from e
+    for info in infos:
+        if not _is_public_ip(info[4][0]):
+            raise UnsafeURLError("image URL points to a private or local address")
+
+
+# ---------------------------------------------------------------------------
+# Downloading (with disk cache)
+# ---------------------------------------------------------------------------
+def _image_cache_path(url: str) -> Path:
+    key = hashlib.sha256(url.encode("utf-8")).hexdigest()
+    return Path(get_settings().CACHE_DIR) / "images" / key
+
+
+def _download(url: str) -> bytes:
+    """GET with redirects checked by hand, a timeout and a byte cap. Patched out in tests."""
+    import httpx  # imported lazily so importing this module stays cheap
+
+    s = get_settings()
+    with httpx.Client(timeout=s.IMAGE_FETCH_TIMEOUT_S, follow_redirects=False,
+                      headers={"User-Agent": _USER_AGENT}) as client:
+        for _ in range(MAX_REDIRECTS + 1):
+            check_url(url)
+            with client.stream("GET", url) as r:
+                if r.is_redirect:
+                    url = urljoin(url, r.headers.get("location", ""))
+                    continue
+                r.raise_for_status()
+                buf = bytearray()
+                for chunk in r.iter_bytes():
+                    buf.extend(chunk)
+                    if len(buf) > s.MAX_IMAGE_BYTES:
+                        raise ImageError("downloaded image is too large")
+                return bytes(buf)
+    raise ImageError("too many redirects")
+
+
+def fetch_bytes(url: str) -> bytes:
+    """Image bytes for `url`: disk cache first; in DEMO_CACHED mode never touch the network."""
+    path = _image_cache_path(url)
+    if path.is_file():
+        return path.read_bytes()
+    if get_settings().DEMO_CACHED:
+        raise OfflineCacheMiss(f"image not cached: {url}")
+    data = _download(url)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_name(f"{path.name}.{uuid.uuid4().hex}.tmp")  # unique: threads may race
+    tmp.write_bytes(data)
+    tmp.replace(path)
+    return data
+
+
+def fetch_first_image(urls: list[str | None]) -> Image.Image | None:
+    """Try each URL in order (e.g. full-size image, then thumbnail); None if all fail."""
+    for url in urls:
+        if not url:
+            continue
+        try:
+            return load_image(fetch_bytes(url))
+        except Exception:  # noqa: BLE001 - any failure just means "try the next URL"
+            continue
+    return None
+
+
+def fetch_many(url_lists: list[list[str | None]]) -> list[Image.Image | None]:
+    """fetch_first_image for every candidate, in parallel threads. Order is preserved."""
+    if not url_lists:
+        return []
+    workers = max(1, min(get_settings().IMAGE_FETCH_WORKERS, len(url_lists)))
+    with ThreadPoolExecutor(max_workers=workers) as pool:
+        return list(pool.map(fetch_first_image, url_lists))

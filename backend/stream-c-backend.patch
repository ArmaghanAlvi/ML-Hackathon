index 0000000..b1e5893
--- /dev/null
+++ b/backend/tests/test_images.py
@@ -0,0 +1,107 @@
+"""images.py: URL safety, base64 limits, disk cache and offline mode. All offline."""
+import base64
+import socket
+
+import pytest
+
+from backend.app.config import get_settings
+from backend.app.services import images
+from backend.tests.fakes import fake_download, image_url, png
+
+
+@pytest.mark.parametrize("url", [
+    "file:///etc/passwd",
+    "ftp://example.com/a.png",
+    "http://127.0.0.1/a.png",
+    "http://localhost:8000/a.png",
+    "http://10.0.0.5/a.png",
+    "http://192.168.1.1/a.png",
+    "http://169.254.169.254/latest/meta-data",
+    "http://[::1]/a.png",
+    "http:///nohost.png",
+])
+def test_unsafe_urls_are_rejected(url):
+    with pytest.raises(images.UnsafeURLError):
+        images.check_url(url)
+
+
+def test_public_address_is_allowed(monkeypatch):
+    monkeypatch.setattr(socket, "getaddrinfo", lambda *a, **k: [(None, None, None, None, ("93.184.215.14", 443))])
+    images.check_url("https://example.com/a.png")
+
+
+def test_host_resolving_to_private_ip_is_rejected(monkeypatch):
+    monkeypatch.setattr(socket, "getaddrinfo", lambda *a, **k: [(None, None, None, None, ("10.1.2.3", 443))])
+    with pytest.raises(images.UnsafeURLError):
+        images.check_url("https://sneaky.example.com/a.png")
+
+
+def test_base64_round_trip_and_data_url_prefix():
+    raw = png("blue")
+    b64 = base64.b64encode(raw).decode()
+    assert images.decode_base64(b64) == raw
+    assert images.decode_base64("data:image/png;base64," + b64) == raw
+    assert images.load_image(raw).size == (64, 64)
+
+
+def test_base64_size_cap(monkeypatch):
+    monkeypatch.setenv("MAX_IMAGE_BYTES", "100")
+    get_settings.cache_clear()
+    with pytest.raises(images.ImageError):
+        images.decode_base64(base64.b64encode(b"x" * 1000).decode())
+
+
+def test_not_an_image():
+    with pytest.raises(images.ImageError):
+        images.load_image(b"definitely not an image")
+
+
+def test_to_jpeg_respects_limit():
+    from PIL import Image
+    big = Image.new("RGB", (3000, 2000), (10, 200, 30))
+    out = images.to_jpeg(big, max_bytes=50_000)
+    assert len(out) <= 50_000 and out[:3] == b"\xff\xd8\xff"
+
+
+def test_fetch_caches_to_disk_and_offline_mode_reads_it(monkeypatch):
+    calls = []
+
+    def dl(url):
+        calls.append(url)
+        return fake_download(url)
+
+    monkeypatch.setattr(images, "_download", dl)
+    url = image_url("red")
+    assert images.fetch_bytes(url) == png("red")
+    assert images.fetch_bytes(url) == png("red")
+    assert calls == [url]  # second read came from disk
+
+    monkeypatch.setenv("DEMO_CACHED", "true")
+    get_settings.cache_clear()
+    assert images.fetch_bytes(url) == png("red")
+    with pytest.raises(images.OfflineCacheMiss):
+        images.fetch_bytes(image_url("blue"))
+
+
+def test_fetch_many_falls_back_to_thumbnail_and_keeps_order(monkeypatch):
+    monkeypatch.setattr(images, "_download", fake_download)
+    out = images.fetch_many([
+        [image_url("broken"), image_url("red", "thumb")],
+        [image_url("blue")],
+        [image_url("broken"), None],
+    ])
+    assert out[0] is not None and out[0].getpixel((0, 0)) == (220, 30, 30)
+    assert out[1] is not None and out[1].getpixel((0, 0)) == (30, 40, 220)
+    assert out[2] is None
+
+
+def test_same_url_fetched_concurrently_does_not_race(monkeypatch):
+    import time
+
+    def slow(url):
+        time.sleep(0.01)
+        return fake_download(url)
+
+    monkeypatch.setattr(images, "_download", slow)
+    out = images.fetch_many([[image_url("red")]] * 16)
+    assert all(im is not None for im in out)

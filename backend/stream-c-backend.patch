 def detect(image: Image.Image) -> list[Box]:
-    """Detect products in `image`; boxes sorted by score, highest first."""
-    raise NotImplementedError("TODO: Stage 4c (detect)")
+    """Detect products in `image`; boxes sorted by score, highest first. [] = use the fallback."""
+    if get_settings().DETECTOR.lower() != "yolo":
+        return []
+    try:
+        boxes = _detect_yolo(image)
+    except Exception as e:  # noqa: BLE001 - detector trouble must never break search
+        log.warning("detector failed, using whole-image fallback: %s", e)
+        return []
+    return sorted(boxes, key=lambda b: b.score, reverse=True)
+
+
+def crop_to_box(image: Image.Image, box: Box | None, padding: float | None = None) -> Image.Image:
+    """Crop `image` to the normalized `box`, padded by `padding` x box size on each side
+    (clamped to the image). box=None returns the whole image."""
+    if box is None:
+        return image
+    pad = get_settings().CROP_PADDING if padding is None else padding
+    W, H = image.size
+    px, py = box.w * pad, box.h * pad
+    left = max(0.0, box.x - px) * W
+    top = max(0.0, box.y - py) * H
+    right = min(1.0, box.x + box.w + px) * W
+    bottom = min(1.0, box.y + box.h + py) * H
+    left, top = min(int(round(left)), W - 1), min(int(round(top)), H - 1)
+    right = min(max(left + 1, int(round(right))), W)
+    bottom = min(max(top + 1, int(round(bottom))), H)
+    return image.crop((left, top, right, bottom))

+"""serp.py: cache-first behaviour, quota log, DEMO_CACHED, errors. All offline."""
+import json
+from pathlib import Path
+
+import pytest
+
+from backend.app.config import get_settings
+from backend.app.services import cache, serp
+from backend.tests.fakes import FakeSerp, png
+
+
+@pytest.fixture
+def fake(monkeypatch):
+    monkeypatch.setenv("SERPAPI_KEY", "test-key")
+    get_settings.cache_clear()
+    f = FakeSerp()
+    monkeypatch.setattr(serp, "_http_get", f.get)
+    monkeypatch.setattr(serp, "_http_upload", f.upload)
+    return f
+
+
+def test_lens_upload_then_cache_hit(fake):
+    meta = {}
+    first = serp.lens_search(image_bytes=png("red"), meta=meta)
+    assert meta["cached"] is False
+    assert fake.engines() == ["google_lens"] and len(fake.uploads) == 1
+    assert fake.calls[0]["image_id"] == "img-1" and fake.calls[0]["api_key"] == "test-key"
+
+    meta = {}
+    second = serp.lens_search(image_bytes=png("red"), meta=meta)
+    assert meta["cached"] is True and second == first
+    assert len(fake.calls) == 1 and len(fake.uploads) == 1  # no new quota
+
+
+def test_raw_response_is_cached_under_the_c4_key(fake):
+    serp.lens_search(image_url="https://img.example.com/a.jpg")
+    key = cache.cache_key(b"https://img.example.com/a.jpg", "google_lens", None)
+    assert cache.load(key) == fake.lens
+    assert fake.calls[0]["url"] == "https://img.example.com/a.jpg"
+
+
+def test_shopping_key_uses_query_text(fake):
+    serp.shopping_search("HydroPeak bottle  yellow")
+    key = cache.cache_key(b"", "google_shopping", "HydroPeak bottle yellow")
+    assert cache.load(key) == fake.shopping
+    assert fake.calls[0]["q"] == "HydroPeak bottle yellow"
+
+
+def test_quota_log_counts_real_calls_only(fake):
+    serp.shopping_search("a")
+    serp.shopping_search("a")  # cache hit
+    serp.shopping_search("b")
+    assert serp.quota_used() == {"google_shopping": 2}
+    rows = [json.loads(line) for line in
+            (Path(get_settings().CACHE_DIR) / "quota_log.jsonl").read_text().splitlines()]
+    assert all(r["ok"] for r in rows) and {"ts", "engine", "key", "latency_ms"} <= set(rows[0])
+
+
+def test_demo_cached_never_calls_network(fake, monkeypatch):
+    monkeypatch.setenv("DEMO_CACHED", "true")
+    get_settings.cache_clear()
+    with pytest.raises(serp.CacheMiss):
+        serp.shopping_search("never cached")
+    assert fake.calls == []
+
+
+def test_demo_cached_serves_hits(fake, monkeypatch):
+    serp.shopping_search("cached one")
+    monkeypatch.setenv("DEMO_CACHED", "true")
+    get_settings.cache_clear()
+    assert serp.shopping_search("cached one") == fake.shopping
+    assert len(fake.calls) == 1
+
+
+def test_quota_exhausted_is_raised_and_not_cached(fake, monkeypatch):
+    monkeypatch.setattr(serp, "_http_get", lambda p: (200, {"error": "Your account has run out of searches."}))
+    with pytest.raises(serp.QuotaExhausted):
+        serp.shopping_search("x")
+    assert cache.load(cache.cache_key(b"", "google_shopping", "x")) is None
+    assert serp.quota_used() == {"google_shopping": 1}  # failed attempts are logged too
+
+
+def test_http_429_is_quota(fake, monkeypatch):
+    monkeypatch.setattr(serp, "_http_get", lambda p: (429, {}))
+    with pytest.raises(serp.QuotaExhausted):
+        serp.shopping_search("x")
+
+
+def test_other_errors_raise_serp_error(fake, monkeypatch):
+    monkeypatch.setattr(serp, "_http_get", lambda p: (500, {"error": "Internal error"}))
+    with pytest.raises(serp.SerpError):
+        serp.shopping_search("x")
+
+
+def test_no_results_is_a_cached_empty_answer(fake, monkeypatch):
+    body = {"error": "Google Lens hasn't returned any results for this query."}
+    monkeypatch.setattr(serp, "_http_get", lambda p: (200, body))
+    assert serp.lens_search(image_url="https://img.example.com/empty.jpg") == body
+    assert cache.load(cache.cache_key(b"https://img.example.com/empty.jpg", "google_lens", None)) == body

+"""detect.py fallback + crop, and the reviews service's trust_rating."""
+import pytest
+from PIL import Image
+
+from backend.app.schemas import Box
+from backend.app.services import detect, reviews
+
+
+def test_default_detector_is_the_whole_image_fallback():
+    assert detect.detect(Image.new("RGB", (100, 100))) == []
+
+
+def test_yolo_failure_falls_back(monkeypatch):
+    monkeypatch.setenv("DETECTOR", "yolo")
+    from backend.app.config import get_settings
+    get_settings.cache_clear()
+
+    def boom(image):
+        raise ImportError("ultralytics not installed")
+
+    monkeypatch.setattr(detect, "_detect_yolo", boom)
+    assert detect.detect(Image.new("RGB", (100, 100))) == []
+
+
+def test_crop_none_is_whole_image():
+    img = Image.new("RGB", (200, 100))
+    assert detect.crop_to_box(img, None).size == (200, 100)
+
+
+def test_crop_with_padding():
+    img = Image.new("RGB", (200, 100))
+    box = Box(x=0.25, y=0.25, w=0.5, h=0.5, label="bottle", score=0.9)
+    assert detect.crop_to_box(img, box, padding=0.0).size == (100, 50)
+    assert detect.crop_to_box(img, box, padding=0.1).size == (120, 60)
+
+
+def test_crop_padding_is_clamped_to_the_image():
+    img = Image.new("RGB", (200, 100))
+    box = Box(x=0.0, y=0.0, w=1.0, h=1.0, label="all", score=1.0)
+    assert detect.crop_to_box(img, box, padding=0.5).size == (200, 100)
+
+
+def test_trust_rating_weights_helpful_reviews_more():
+    long_review = "word " * 100   # stub helpfulness 1.0
+    short_review = "meh"          # stub helpfulness 0.01
+    t = reviews.trust_rating([5.0, 1.0], [long_review, short_review])
+    assert t == pytest.approx((1.0 * 5 + 0.01 * 1) / 1.01)
+    assert reviews.trust_rating([], []) is None
+    assert reviews.trust_rating([4.0], [""]) is None

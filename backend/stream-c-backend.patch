+"""pipeline.py
+
+Owner: Stream C · Roadmap: Stage 4 (live /api/search), 4f (text refinement), 4g (cached mode)
+Purpose: the live search pipeline, kept separate from the FastAPI route so it can be tested
+without a web server:
+
+    image -> detect -> crop -> Lens (serp.py, cached) -> Shopping on the top title + refinement
+          -> fetch candidate images in parallel -> matcher scores + labels -> C7 ranking
+          -> SearchResponse (contract C1)
+
+Notes
+- Candidates come from both Lens visual matches and Shopping results, de-duplicated by link.
+- Only USD prices enter the ranking pool (suggestion 9). Other currencies are still shown.
+- A used/refurbished condition from SerpApi goes into `description` (no contract change needed).
+- A refinement on the same photo re-uses the cached Lens result, so it only costs a Shopping search.
+- Reviews (trust_rating, top_reviews) are Stage 7e and stay empty for now.
+"""
+from __future__ import annotations
+
+import hashlib
+import logging
+import time
+from typing import Any
+
+from backend.app.config import get_settings
+from backend.app.schemas import Box, Candidate, SearchRequest, SearchResponse
+from backend.app.services import detect, images, ranking, serp
+from backend.app.services import matcher as matcher_service
+
+log = logging.getLogger(__name__)
+
+_CURRENCY = {"$": "USD", "US$": "USD", "€": "EUR", "£": "GBP", "₹": "INR", "¥": "JPY", "C$": "CAD", "A$": "AUD"}
+_LABEL_ORDER = {"identical": 0, "similar": 1, "none": 2}
+MAX_QUERY_CHARS = 100
+
+
+def _currency(symbol_or_price: Any) -> str:
+    s = str(symbol_or_price or "").strip()
+    if not s:
+        return "USD"
+    if s.upper() in {"USD", "EUR", "GBP", "INR", "JPY", "CAD", "AUD"}:
+        return s.upper()
+    for sym in sorted(_CURRENCY, key=len, reverse=True):
+        if s.startswith(sym):
+            return _CURRENCY[sym]
+    return s[:3].upper()
+
+
+def _num(v: Any) -> float | None:
+    try:
+        return float(v) if v is not None else None
+    except (TypeError, ValueError):
+        return None
+
+
+def _int(v: Any) -> int | None:
+    f = _num(v)
+    return int(f) if f is not None and f >= 0 else None
+
+
+def _rating(v: Any) -> float | None:
+    f = _num(v)
+    return f if f is not None and 0 <= f <= 5 else None
+
+

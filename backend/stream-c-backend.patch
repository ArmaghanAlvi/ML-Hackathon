+"""The live pipeline end to end with fake SerpApi + fake image downloads. All offline."""
+import base64
+
+import pytest
+
+from backend.app.config import get_settings
+from backend.app.schemas import Box, SearchRequest
+from backend.app.services import images, pipeline, serp
+from backend.tests.fakes import FakeSerp, fake_download, image_url, png
+
+
+@pytest.fixture
+def fake(monkeypatch):
+    monkeypatch.setenv("SERPAPI_KEY", "test-key")
+    monkeypatch.setenv("USE_MOCK_RESPONSE", "false")
+    get_settings.cache_clear()
+    f = FakeSerp()
+    monkeypatch.setattr(serp, "_http_get", f.get)
+    monkeypatch.setattr(serp, "_http_upload", f.upload)
+    monkeypatch.setattr(images, "_download", fake_download)
+    return f
+
+
+def b64(color="red"):
+    return base64.b64encode(png(color)).decode()
+
+
+def test_full_pipeline_returns_a_valid_response(fake):
+    resp = pipeline.run_search(SearchRequest(image_base64=b64("red")))
+    ids = {c.id for c in resp.candidates}
+    by_id = {c.id: c for c in resp.candidates}
+
+    # Lens entry without an image is dropped; Shopping duplicate of lens 1 is de-duplicated.
+    assert ids == {"l1", "l2", "l3", "l4", "s1", "s3"}
+    assert by_id["l1"].match_label == "identical"
+    assert by_id["l2"].match_label in {"identical", "similar"}  # fetched via thumbnail fallback
+    assert by_id["l3"].match_label == "none"                    # blue vs red
+    assert by_id["s1"].description == "Condition: used"
+    assert by_id["l4"].currency == "EUR"
+
+    # Ranking only uses USD identical/similar candidates.
+    for key in ("top_cheapest", "top_rated", "best_value", "frontier"):
+        assert set(getattr(resp, key)) <= {"l1", "l2", "s1"}, key
+    assert resp.top_cheapest[0] == "s1"
+    assert by_id["l1"].adjusted_rating is not None and by_id["l3"].adjusted_rating is None
+
+    assert resp.cached is False and resp.detections == [] and resp.selected_box is None
+    assert {"decode", "detect", "lens", "shopping", "match", "rank", "total"} <= set(resp.timings_ms)
+    assert fake.engines() == ["google_lens", "google_shopping"]
+    assert fake.calls[1]["q"] == "HydroPeak 32 oz Bottle Red"
+
+
+def test_second_identical_request_is_served_from_cache(fake):
+    req = SearchRequest(image_base64=b64("red"))
+    first = pipeline.run_search(req)
+    second = pipeline.run_search(req)
+    assert second.cached is True and second.query_id == first.query_id
+    assert len(fake.calls) == 2
+
+
+def test_refinement_reuses_lens_and_only_costs_shopping(fake):
+    pipeline.run_search(SearchRequest(image_base64=b64("red")))
+    resp = pipeline.run_search(SearchRequest(image_base64=b64("red"), text="yellow version"))
+    assert fake.engines() == ["google_lens", "google_shopping", "google_shopping"]
+    assert fake.calls[-1]["q"] == "HydroPeak 32 oz Bottle Red yellow version"
+    assert resp.cached is False
+
+
+def test_url_input_without_box_uses_lens_url_flow(fake):
+    pipeline.run_search(SearchRequest(image_url=image_url("red")))
+    assert fake.calls[0]["url"] == image_url("red") and fake.uploads == []
+
+
+def test_user_box_is_used_and_crop_is_uploaded(fake):
+    box = Box(x=0.1, y=0.1, w=0.5, h=0.5, label="user", score=1.0)
+    resp = pipeline.run_search(SearchRequest(image_url=image_url("red"), box=box))
+    assert resp.selected_box == box and len(fake.uploads) == 1
+
+
+def test_demo_cached_mode_works_offline_after_one_live_run(fake, monkeypatch):
+    req = SearchRequest(image_base64=b64("red"))
+    live = pipeline.run_search(req)
+    monkeypatch.setenv("DEMO_CACHED", "true")
+    get_settings.cache_clear()
+    monkeypatch.setattr(images, "_download", lambda url: (_ for _ in ()).throw(AssertionError("network")))
+    cached = pipeline.run_search(req)
+    assert cached.cached is True
+    assert [c.match_label for c in cached.candidates] == [c.match_label for c in live.candidates]
+
+
+def test_demo_cached_miss_raises(fake, monkeypatch):
+    monkeypatch.setenv("DEMO_CACHED", "true")
+    get_settings.cache_clear()
+    with pytest.raises(serp.CacheMiss):
+        pipeline.run_search(SearchRequest(image_base64=b64("blue")))
+
+
+def test_empty_lens_result_gives_empty_lists(fake):
+    fake.lens = {"error": "Google Lens hasn't returned any results for this query."}
+    resp = pipeline.run_search(SearchRequest(image_base64=b64("green")))
+    assert resp.candidates == [] and resp.top_cheapest == [] and resp.frontier == []
+    assert fake.engines() == ["google_lens"]  # no title -> no Shopping search
+
+
+def test_currency_parsing():
+    assert pipeline._currency("$19.99") == "USD"
+    assert pipeline._currency("€") == "EUR"
+    assert pipeline._currency(None) == "USD"
+    assert pipeline._currency("C$12") == "CAD"

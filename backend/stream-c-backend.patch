+"""spike_detect.py
+
+Owner: Stream C · Roadmap: Stage 1b (detector test)
+Purpose: run a YOLO detector on ~10 demo photos and save annotated copies, so the team can pick
+DETECTOR=yolo or the fallback (whole image + user drags a box) at CP1.
+
+Needs the heavy deps (NOT installed by default):
+    pip install -r backend/requirements-models.txt
+Usage (repo root):
+    python backend/scripts/spike_detect.py photos/*.jpg --weights yolo26n.pt --out spike_detect_out
+    python backend/scripts/spike_detect.py photos/*.jpg --weights yoloe-11s-seg.pt --prompt product
+For each photo it prints the boxes (label, confidence) and the time taken. Judge: is the demo
+object boxed, as the top box, in most photos? If not, use the fallback.
+"""
+from __future__ import annotations
+
+import argparse
+import time
+from pathlib import Path
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("images", nargs="+")
+    ap.add_argument("--weights", default="yolo26n.pt")
+    ap.add_argument("--prompt", action="append", help="Open-vocabulary class prompt (YOLOE models only)")
+    ap.add_argument("--out", default="spike_detect_out")
+    args = ap.parse_args()
+
+    from ultralytics import YOLO
+
+    model = YOLO(args.weights)
+    if args.prompt:
+        model.set_classes(args.prompt)  # YOLOE; recent ultralytics versions may need text embeddings
+    out = Path(args.out)
+    out.mkdir(parents=True, exist_ok=True)
+
+    hits = 0
+    for path in args.images:
+        t0 = time.perf_counter()
+        res = model.predict(path, verbose=False)[0]
+        ms = (time.perf_counter() - t0) * 1000
+        boxes = [(res.names[int(c)], round(float(p), 2))
+                 for c, p in zip(res.boxes.cls.tolist(), res.boxes.conf.tolist())]
+        hits += bool(boxes)
+        print(f"{path}: {ms:.0f} ms  {boxes[:5]}")
+        res.save(filename=str(out / Path(path).name))
+    print(f"\n{hits}/{len(args.images)} photos had at least one box. Annotated copies in {out}/")
+
+
+if __name__ == "__main__":
+    main()

+
+def test_missing_key(monkeypatch):
+    monkeypatch.setenv("SERPAPI_KEY", "")
+    get_settings.cache_clear()
+    with pytest.raises(serp.MissingKey):
+        serp.shopping_search("x")
+
+
+def test_big_images_are_shrunk_under_the_upload_limit(fake):
+    import io
+    import numpy as np
+    from PIL import Image
+
+    noise = (np.random.default_rng(0).random((1600, 1600, 3)) * 255).astype("uint8")
+    buf = io.BytesIO()
+    Image.fromarray(noise).save(buf, format="PNG")
+    assert buf.tell() > 500_000
+    serp.lens_search(image_bytes=buf.getvalue())
+    assert len(fake.uploads[0]) <= serp.UPLOAD_MAX_BYTES
+

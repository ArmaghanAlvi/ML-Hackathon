@@ -0,0 +1,90 @@
+"""Offline fakes for SerpApi and image downloads (used by the serp / pipeline / route tests)."""
+from __future__ import annotations
+
+import io
+
+from PIL import Image
+
+COLORS = {
+    "red": (220, 30, 30),
+    "darkred": (210, 20, 25),
+    "blue": (30, 40, 220),
+    "green": (40, 200, 60),
+}
+
+
+def png(color: str = "red", size: int = 64) -> bytes:
+    buf = io.BytesIO()
+    Image.new("RGB", (size, size), COLORS[color]).save(buf, format="PNG")
+    return buf.getvalue()
+
+
+def image_url(color: str, kind: str = "img") -> str:
+    return f"https://img.example.com/{kind}/{color}.png"
+
+
+def fake_download(url: str) -> bytes:
+    """https://img.example.com/<kind>/<color>.png -> a solid-colour PNG. 'broken' fails."""
+    name = url.rsplit("/", 1)[-1].split(".")[0]
+    if name not in COLORS:
+        raise OSError(f"cannot fetch {url}")
+    return png(name)
+
+
+LENS = {
+    "search_metadata": {"status": "Success"},
+    "visual_matches": [
+        {"position": 1, "title": "HydroPeak 32 oz Bottle Red", "link": "https://shop.example.com/1",
+         "source": "Amazon", "price": {"value": "$30*", "extracted_value": 30.0, "currency": "$"},
+         "rating": 4.7, "reviews": 1200, "image": image_url("red"), "thumbnail": image_url("red", "thumb")},
+        {"position": 2, "title": "HydroPeak Bottle Dark Red", "link": "https://shop.example.com/2",
+         "source": "Target", "price": {"value": "$25", "extracted_value": 25.0, "currency": "$"},
+         "rating": 4.4, "reviews": 300, "image": image_url("broken"), "thumbnail": image_url("darkred", "thumb")},
+        {"position": 3, "title": "Blue Mug", "link": "https://shop.example.com/3", "source": "eBay",
+         "price": {"value": "$5", "extracted_value": 5.0, "currency": "$"},
+         "image": image_url("blue")},
+        {"position": 4, "title": "Red Bottle EU", "link": "https://shop.example.eu/4", "source": "Shop EU",
+         "price": {"value": "€20", "extracted_value": 20.0, "currency": "€"}, "rating": 4.9, "reviews": 50,
+         "image": image_url("red")},
+        {"position": 5, "title": "No image entry", "link": "https://shop.example.com/5"},
+    ],
+}
+
+SHOPPING = {
+    "search_metadata": {"status": "Success"},
+    "shopping_results": [
+        {"position": 1, "title": "HydroPeak 32oz Red - Used", "product_link": "https://g.example.com/p1",
+         "source": "Walmart", "price": "$19.99", "extracted_price": 19.99, "rating": 4.5, "reviews": 80,
+         "second_hand_condition": "used", "thumbnail": image_url("red", "thumb")},
+        {"position": 2, "title": "Duplicate of lens 1", "product_link": "https://shop.example.com/1",
+         "source": "Amazon", "price": "$30.00", "extracted_price": 30.0, "thumbnail": image_url("red")},
+        {"position": 3, "title": "Green bottle", "product_link": "https://g.example.com/p3",
+         "source": "REI", "price": "$40.00", "extracted_price": 40.0, "rating": 4.8, "reviews": 900,
+         "thumbnail": image_url("green", "thumb")},
+    ],
+}
+
+
+class FakeSerp:
+    """Stands in for serp._http_get / serp._http_upload and records every call."""
+
+    def __init__(self, lens: dict | None = None, shopping: dict | None = None):
+        self.lens = LENS if lens is None else lens
+        self.shopping = SHOPPING if shopping is None else shopping
+        self.calls: list[dict] = []
+        self.uploads: list[bytes] = []
+
+    def get(self, params: dict) -> tuple[int, dict]:
+        self.calls.append(params)
+        if params["engine"] == "google_lens":
+            return 200, self.lens
+        if params["engine"] == "google_shopping":
+            return 200, self.shopping
+        return 400, {"error": "unknown engine"}
+
+    def upload(self, jpeg: bytes, api_key: str) -> tuple[int, dict]:
+        self.uploads.append(jpeg)
+        return 200, {"image_id": f"img-{len(self.uploads)}"}
+
+    def engines(self) -> list[str]:
+        return [c["engine"] for c in self.calls]

+
+
+def score_candidate_urls(query: Image.Image, url_lists: list[list[str | None]]
+                         ) -> tuple[list[float], list[str], int]:
+    """Fetch each candidate's image (first URL that works, in parallel) and score it.
+
+    Returns (scores, labels, n_failed), aligned with `url_lists`.

+log = logging.getLogger(__name__)
+
+# COCO classes that are never the product the user means.
+_IGNORE_LABELS = {"person", "dining table", "bed", "couch", "chair", "toilet", "car", "bus", "truck"}
+MIN_SCORE = 0.25
+
+
+@lru_cache(maxsize=1)
